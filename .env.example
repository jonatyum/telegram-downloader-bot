BOT_TOKEN=your_bot_token_here

# Chat ID del administrador para comandos de admin (opcional)
# Puedes obtener tu chat ID enviando un mensaje a @userinfobot en Telegram
ADMIN_CHAT_ID=

# Avisar "🤖 Bot iniciado" al admin en cada arranque. En Render free el bot se levanta
# de cero cada vez que despierta, así que déjalo vacío/0 para no recibir spam. Pon 1
# solo si quieres ver cada arranque (útil en local).
NOTIFY_ON_START=

# Conexión a Postgres (Supabase). Usar la connection string del pooler en modo
# Transaction (puerto 6543): Supabase → Settings → Database → Connection pooling.
# Ej: postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=

# URL pública HTTPS para el webhook. En local déjala vacía → el bot usa polling.
# En Render se toma automáticamente de RENDER_EXTERNAL_URL, no hace falta ponerla.
WEBHOOK_URL=

# Token secreto opcional que Telegram enviará en cada webhook (defensa extra).
WEBHOOK_SECRET=

# --- /version (comando de admin) ---
# En Render el commit se toma solo de RENDER_GIT_COMMIT (no hace falta nada).
# APP_COMMIT / APP_BRANCH: override manual del commit/rama mostrado (otros hosts).
APP_COMMIT=
APP_BRANCH=
# GITHUB_REPO: "owner/repo" para comparar con GitHub (si no se autodetecta del remoto).
GITHUB_REPO=
# GITHUB_TOKEN: solo si el repo es PRIVADO o topas rate limit de la API pública.
GITHUB_TOKEN=

# Puerto del servidor HTTP. Render inyecta PORT automáticamente; en local se usa
# para el health endpoint en modo polling.
HEALTH_PORT=8080

# --- Límites de memoria (importan en hosts con poca RAM, p. ej. Render free 512 MB) ---
# Descargas simultáneas. Cada una puede comprimir/enviar a la vez y eso consume RAM.
# Local: 5 está bien. Render free: usa 1-2.
MAX_CONCURRENT_DOWNLOADS=5
# Resolución máxima al re-comprimir con ffmpeg. Render free: 720 baja el pico de RAM.
MAX_COMPRESS_HEIGHT=1080
# Rechaza videos estimados mayores a esto (MB). Render free: ~50.
MAX_PREFLIGHT_SIZE_MB=150
# Tope para enviar como documento (MB). Render free: ~50 (Telegram no envía más igual).
MAX_DOCUMENT_SIZE_MB=2000

# --- Canal web (api.py) — servicio de Render separado, no necesita BOT_TOKEN ni DATABASE_URL ---
# Origen(es) del frontend en GitHub Pages, para el header CORS. Coma-separados si hay más de uno.
WEB_ORIGINS=*
# Máximo de MB por archivo en la web (red de seguridad de disco; no hay límite de Telegram aquí).
MAX_WEB_FILE_MB=2000
# Minutos que vive un resultado en disco antes de que el barrido lo borre.
JOB_TTL_MINUTES=30
# Máximo de jobs por IP en la ventana de RATE_LIMIT_WINDOW (comparte esa ventana con el bot).
WEB_RATE_LIMIT_REQUESTS=8

# --- YouTube: cookies (aplica al bot Y al canal web) ---
# YouTube bloquea las IPs de datacenter con "Sign in to confirm you're not a bot": el
# título se scrapea pero no llega NINGÚN formato, así que la descarga falla. Una sesión
# autenticada es lo único que lo evita de forma fiable.
#
# Ojo, dos cosas que no son opcionales:
#   1. Usá una cuenta DESCARTABLE, nunca la tuya: YouTube puede banearla.
#   2. Hace falta un runtime JS (deno, ya incluido en los dos Dockerfiles). Con cookies
#      yt-dlp pasa a los clientes autenticados y los tres requieren JS; sin runtime
#      devolverían solo storyboards en vez de video.
#
# Cómo generarlo: en un navegador logueado con la cuenta descartable, exportá las
# cookies en formato Netscape (extensión "Get cookies.txt LOCALLY" o similar).
# En Render: subilo como Secret File y apuntá esta variable a su ruta montada.
# Vacío = sin cookies (funciona igual para TikTok, Instagram, Facebook y X).
YOUTUBE_COOKIES_FILE=

# Clientes de InnerTube que yt-dlp prueba en YouTube, en orden y separados por coma.
# El chequeo antibot desde IPs de datacenter (Render corre sobre Google Cloud) no cae
# igual sobre todos los clientes: `web` es el primero al que se lo exigen, y los de TV
# y visores VR a veces siguen contestando desde la misma IP. yt-dlp prueba todos y junta
# los formatos de los que respondan, así que sumar clientes solo puede ayudar; el costo
# es una petición más por extracción. Un nombre desconocido se ignora con un warning.
# Vacío o "default" = el comportamiento de fábrica de yt-dlp.
YOUTUBE_PLAYER_CLIENTS=default,tv_simply,android_vr

# Proxy usado SOLO para YouTube (extracción y descarga). Vacío = sin proxy.
# Cambiar de cliente ayuda a veces, pero el bloqueo de YouTube es por reputación de IP
# y ocurre antes de mirar quién pregunta: desde una IP de datacenter no hay librería ni
# cliente que lo esquive de forma fiable. Sin cookies, lo único que lo resuelve de raíz
# es que la petición salga de otra IP (proxy residencial o móvil).
# Formato: "http://usuario:clave@host:puerto" (también socks5://).
# Ojo con el costo: estos proxies se cobran por GB y acá pasa el video entero.
# No se aplica a TikTok, Instagram, Facebook ni X: esas bajan directo.
YOUTUBE_PROXY=

# --- YouTube: worker remoto en una conexión residencial ---
# El bloqueo de YouTube es por reputación de IP y ocurre antes de mirar quién pregunta,
# así que desde un datacenter no hay librería, cliente ni herramienta que lo esquive.
# Y las URLs de los formatos vienen firmadas con la IP que las pidió (el parámetro "ip"
# está dentro de "sparams"), o sea que tampoco sirve resolver el link en casa y bajar
# los bytes en el servidor: recibirías un 403. La descarga entera tiene que salir por
# la conexión residencial. Eso es lo que hace worker.py.
#
# En la máquina de casa (misma imagen que la API, otro comando):
#   YOUTUBE_WORKER_TOKEN=... uvicorn worker:app --host 127.0.0.1 --port 8100
#   docker run -e YOUTUBE_WORKER_TOKEN=... -p 8100:8100 <imagen> \
#     sh -c "uvicorn worker:app --host 0.0.0.0 --port 8100"
# y se publica con un túnel (cloudflared, Tailscale) en un dominio propio.
#
# En el servidor: apuntá YOUTUBE_WORKER_URL a ese dominio y usá el MISMO token.
# Si el worker no responde —máquina apagada, túnel caído— el servidor sigue por su
# camino local: apagarla degrada YouTube, no rompe la app. Vacío = sin worker.
YOUTUBE_WORKER_URL=
# Secreto compartido. Obligatorio: el túnel deja el worker abierto a internet y sin
# esto cualquiera podría usar tu conexión de casa para descargar.
YOUTUBE_WORKER_TOKEN=
# Techo de una descarga completa vía worker, en segundos. Incluye lo que tarda en bajar
# de YouTube MÁS lo que tarda en subirle el archivo al servidor por tu conexión, que
# suele ser la parte lenta.
YOUTUBE_WORKER_TIMEOUT=300
# Segundos que se deja de intentar tras un fallo de conexión. Es lo que evita que, con
# la máquina apagada, cada link de YouTube pague el timeout antes de caer a local.
YOUTUBE_WORKER_COOLDOWN=300
